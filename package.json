{
  "name": "dolphin-anty-desktop",
  "version": "1.0.0",
  "description": "Десктопный антидетект-браузер для мультиаккаунтинга (аналог Dolphin Anty Pro)",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.js --mode production",
    "dev": "concurrently \"tsc -p tsconfig.main.json -w\" \"webpack --config webpack.renderer.js --mode development -w\" \"wait-on dist/main/main.js dist/renderer/bundle.js && electron . --dev\"",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:renderer": "webpack --config webpack.renderer.js --mode development -w",
    "package": "npm run build && electron-builder --win",
    "test": "jest --config jest.config.js",
    "lint": "eslint src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "crypto-js": "^4.2.0",
    "electron-store": "^8.2.0",
    "express": "^4.21.0",
    "puppeteer-core": "^23.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
